{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Record the actual kernel trace",
      "type": "process",
      "command": "python3",
      "args": ["scripts/trace.py", "--file", "${relativeFile}", "--declaration", "${input:declaration}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ],
  "inputs": [
    {
      "id": "declaration",
      "type": "promptString",
      "description": "Full name of a theorem in the open file"
    }
  ]
}
